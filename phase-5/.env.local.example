# Example environment variables for Phase 5 Docker Compose
# Copy this file to .env.local and fill in your values

# PostgreSQL connection (use Neon for serverless)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Optional: If using local PostgreSQL instead of Neon
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/todo

# Dapr configuration (for local development)
DAPR_HOST=localhost
DAPR_HTTP_PORT=3500
