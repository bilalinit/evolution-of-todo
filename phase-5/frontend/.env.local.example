# Frontend Environment Variables Example
# Copy this file to .env.local and fill in your actual values

# ===================================================================
# CLIENT-SIDE VARIABLES (accessible in browser)
# ===================================================================

# Backend API URLs (client-side - used by browser)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# WebSocket URL for real-time updates
NEXT_PUBLIC_WEBSOCKET_URL=ws://127.0.0.1:8004

# ChatKit API URL
NEXT_PUBLIC_CHATKIT_API_URL=http://127.0.0.1:8000/api/chatkit

# ChatKit Domain Key (optional - from OpenAI platform)
NEXT_PUBLIC_CHATKIT_DOMAIN_KEY=your-domain-key-from-openai-platform

# Demo mode - when true, shows mock data instead of real API calls
NEXT_PUBLIC_DEMO_MODE=false

# Debug mode - enables verbose logging
NEXT_PUBLIC_DEBUG=true

# ===================================================================
# SERVER-SIDE VARIABLES (only accessible in Next.js API routes)
# ===================================================================

# Backend URL (server-side - used by Next.js API routes inside Kubernetes)
# For local development: http://127.0.0.1:8000
# For Kubernetes: http://backend-api-todo-backend:8000
BACKEND_URL=http://127.0.0.1:8000

# Better Auth Configuration
BETTER_AUTH_URL=http://localhost:3000/
BETTER_AUTH_SECRET=change-this-to-a-random-secret-key-min-32-chars

# Node environment
NODE_ENV=production

# Server port
PORT=3000

# ===================================================================
# NOTES
# ===================================================================
#
# - Variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# - Never put secrets in NEXT_PUBLIC_ variables!
# - For production Kubernetes deployment, these are set via Helm values
# - For local development, use the values above
