# Backend Environment Variables Example
# Copy this file to .env and fill in your actual values

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================

# PostgreSQL Database URL
# For Neon (recommended): postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require&channel_binding=require
# For local PostgreSQL: postgresql://user:password@localhost:5432/dbname
DATABASE_URL=postgresql://user:password@host:5432/database_name?sslmode=require

# ===================================================================
# AI API KEYS
# ===================================================================

# Xiaomi (HyperGPT) API Key for OpenAI Agents SDK
# Get your key from: https://platform.xiaomi.com/
XIAOMI_API_KEY=your_xiaomi_api_key_here

# OpenAI API Key (fallback for agent operations)
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ===================================================================
# SERVER CONFIGURATION
# ===================================================================

# Server host binding
HOST=0.0.0.0

# Server port
PORT=8000

# Debug mode (true for development, false for production)
DEBUG=true

# ===================================================================
# BETTER AUTH CONFIGURATION
# ===================================================================

# Better Auth secret key (must be at least 32 characters)
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=your-secret-key-here-at-least-32-characters-long

# Better Auth URL (for production)
BETTER_AUTH_URL=http://localhost:3000/

# ===================================================================
# DAPR CONFIGURATION (for microservices)
# ===================================================================

# Dapr sidecar host (usually localhost for local dev)
DAPR_HOST=localhost

# Dapr HTTP port (default: 3500)
DAPR_HTTP_PORT=3500

# ===================================================================
# MCP SERVER CONFIGURATION
# ===================================================================

# MCP server timeout in seconds
MCP_SERVER_TIMEOUT=60

# ===================================================================
# OPTIONAL: ADDITIONAL CONFIGURATION
# ===================================================================

# Frontend URL for CORS (if needed)
# FRONTEND_URL=http://localhost:3000

# WebSocket service URL (if needed)
# WEBSOCKET_SERVICE_URL=ws://localhost:8004

# ===================================================================
# NOTES
# ===================================================================
#
# For local development with Minikube/Kubernetes:
# - These variables are loaded from Kubernetes secrets, not .env
# - Use: kubectl create secret generic app-secrets --from-literal=KEY=value
# - See ../k8s-dapr/DAPR_README.md for complete setup guide
#
# For Docker Compose development:
# - Copy this file to .env and fill in actual values
# - Run: docker-compose up
